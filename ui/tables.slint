import { Theme } from "theme.slint";
import { ItemRow, TreeRow } from "structs.slint";
import { ListView } from "std-widgets.slint";

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <length> cell-width: 90px;
    in property <bool> stretch: false;
    in property <bool> right: false;
    in property <bool> sortable: true;
    in property <bool> active-sort: false;
    in property <bool> ascending: true;
    in property <int> column: 0;
    callback sort(int);

    width: cell-width;
    horizontal-stretch: stretch ? 1 : 0;
    background: transparent;

    Text {
        text: root.label + (root.active-sort ? (root.ascending ? "  ▲" : "  ▼") : "");
        font-size: 12px;
        font-weight: 600;
        color: root.active-sort ? Theme.text : Theme.text-3;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        overflow: elide;
    }

    ta := TouchArea {
        enabled: root.sortable;
        mouse-cursor: root.sortable ? pointer : default;
        clicked => { root.sort(root.column); }
    }
}

export component TableHeader inherits Rectangle {
    in property <bool> compact: false;
    in property <int> sort-column: -1;
    in property <bool> sort-asc: true;
    callback sort(int);

    height: 28px;
    background: Theme.panel-2;
    border-radius: Theme.radius-sm;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        Rectangle {
            // The name column has no fixed width so it absorbs the remaining
            // space, keeping the header aligned with the rows below.
            horizontal-stretch: 1;
            background: transparent;
            Text {
                text: "Name";
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-3;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
                overflow: elide;
            }
        }
        if !root.compact: HeaderCell {
            label: "Type";
            cell-width: 86px;
            column: 1;
            sortable: false;
        }
        HeaderCell {
            label: "Size";
            cell-width: 86px;
            right: true;
            column: 2;
            active-sort: root.sort-column == 2;
            ascending: root.sort-asc;
            sort(col) => { root.sort(col); }
        }
        if !root.compact: HeaderCell {
            label: "Allocated";
            cell-width: 86px;
            right: true;
            column: 3;
            active-sort: root.sort-column == 3;
            ascending: root.sort-asc;
            sort(col) => { root.sort(col); }
        }
        if !root.compact: HeaderCell {
            label: "Modified";
            cell-width: 108px;
            column: 4;
            active-sort: root.sort-column == 4;
            ascending: root.sort-asc;
            sort(col) => { root.sort(col); }
        }
        if !root.compact: HeaderCell {
            label: "Category";
            cell-width: 152px;
            column: 5;
            sortable: false;
        }
        HeaderCell {
            label: "Risk";
            cell-width: 108px;
            column: 6;
            active-sort: root.sort-column == 6;
            ascending: root.sort-asc;
            sort(col) => { root.sort(col); }
        }
    }
}

export component ItemTable inherits Rectangle {
    in property <[ItemRow]> rows;
    in property <bool> compact: false;
    in property <int> sort-column: -1;
    in property <bool> sort-asc: true;
    in property <string> empty-text: "No items";
    callback select(int, bool);
    callback activate(int);
    callback context(int, float, float);
    callback sort(int);

    background: transparent;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        TableHeader {
            compact: root.compact;
            sort-column: root.sort-column;
            sort-asc: root.sort-asc;
            sort(col) => { root.sort(col); }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.rows.length == 0: Text {
            text: root.empty-text;
            color: Theme.text-3;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            vertical-stretch: 1;
        }

        if root.rows.length > 0: ListView {
            vertical-stretch: 1;
            for row[i] in root.rows: Rectangle {
                width: 100%;
                height: 31px;
                background: row.selected ? Theme.selected
                    : Math.mod(i, 2) == 0 ? transparent
                    : (Theme.dark ? #0d1626 : #fafcff);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;

                        Text {
                            text: row.is-dir ? "▸" : "·";
                            width: 12px;
                            font-size: 14px;
                            color: row.is-dir ? Theme.warning : Theme.text-3;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: row.name;
                            horizontal-stretch: 1;
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    if !root.compact: Text {
                        text: row.type-label;
                        width: 86px;
                        font-size: 12px;
                        color: Theme.text-3;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: row.size;
                        width: 86px;
                        font-size: 13px;
                        color: Theme.text-2;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if !root.compact: Text {
                        text: row.allocated;
                        width: 86px;
                        font-size: 12px;
                        color: Theme.text-3;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if !root.compact: Text {
                        text: row.modified;
                        width: 108px;
                        font-size: 12px;
                        color: Theme.text-3;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if !root.compact: Text {
                        text: row.category;
                        width: 152px;
                        font-size: 12px;
                        color: row.category-color;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: row.risk;
                        width: 108px;
                        font-size: 12px;
                        font-weight: 600;
                        color: row.risk-color;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                ta := TouchArea {
                    mouse-cursor: pointer;

                    double-clicked => { root.activate(row.id); }

                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                            root.select(row.id, ev.modifiers.control || ev.modifiers.shift);
                        } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                            root.context(row.id, (ta.absolute-position.x + ta.mouse-x) / 1px, (ta.absolute-position.y + ta.mouse-y) / 1px);
                        }
                    }
                }
            }
        }
    }
}

export component TreePanel inherits Rectangle {
    in property <[TreeRow]> rows;
    in property <string> summary;
    callback select(int, bool);
    callback activate(int);
    callback toggle(int);
    callback context(int, float, float);

    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 36px;
            background: Theme.panel-2;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: "Folders";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Text {
                    text: root.summary;
                    horizontal-stretch: 1;
                    font-size: 12px;
                    color: Theme.text-3;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        if root.rows.length == 0: Text {
            text: "No folders to show";
            font-size: 13px;
            color: Theme.text-3;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            vertical-stretch: 1;
        }

        if root.rows.length > 0: ListView {
            vertical-stretch: 1;
            for row[i] in root.rows: Rectangle {
                width: 100%;
                height: 27px;
                background: row.selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;

                HorizontalLayout {
                    padding-left: 6px + row.depth * 14px;
                    padding-right: 8px;
                    spacing: 3px;

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        background: transparent;
                        visible: row.has-children;

                        Text {
                            text: row.expanded ? "▾" : "▸";
                            font-size: 12px;
                            color: Theme.text-2;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 16px;
                            height: 16px;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle(row.id); }
                        }
                    }

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        background: transparent;
                        visible: !row.has-children;

                        Text {
                            text: " ";
                            width: 16px;
                            height: 16px;
                        }
                    }

                    Text {
                        text: row.is-dir ? "▣" : "·";
                        width: 15px;
                        font-size: 12px;
                        color: row.color;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: row.name;
                        horizontal-stretch: 1;
                        font-size: 13px;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: row.size;
                        width: 62px;
                        font-size: 12px;
                        color: Theme.text-3;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                ta := TouchArea {
                    mouse-cursor: pointer;
                    double-clicked => { root.activate(row.id); }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                            root.select(row.id, ev.modifiers.control || ev.modifiers.shift);
                        } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                            root.context(row.id, (ta.absolute-position.x + ta.mouse-x) / 1px, (ta.absolute-position.y + ta.mouse-y) / 1px);
                        }
                    }
                }
            }
        }
    }
}
