// Windows resources for SmartDisk: application icon and version information.
#pragma code_page(65001)
#include <winver.h>

1 ICON "resources/icons/smartdisk.ico"

1 VERSIONINFO
FILEVERSION 1,0,3,0
PRODUCTVERSION 1,0,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SmartDisk contributors\0"
            VALUE "FileDescription", "SmartDisk disk space analyzer\0"
            VALUE "FileVersion", "1.0.3.0\0"
            VALUE "InternalName", "smartdisk\0"
            VALUE "LegalCopyright", "MIT License. Copyright (c) 2026 SmartDisk contributors.\0"
            VALUE "OriginalFilename", "SmartDisk.exe\0"
            VALUE "ProductName", "SmartDisk\0"
            VALUE "ProductVersion", "1.0.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
